# ==============================================================================
# National Welfare Schemes Portal - Configuration
# ==============================================================================

# Server Port (Render sets this dynamically; defaults to 3000 locally)
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. REAL LIVE EMAIL DISPATCH (Choose either Standard SMTP or Resend API)
# ------------------------------------------------------------------------------
# Option A: Standard SMTP (Gmail, Outlook, Brevo, SendGrid, Amazon SES, or custom domain)
# For Gmail: Use your Gmail address and a 16-character Google App Password (myaccount.google.com/apppasswords)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="National Schemes Portal <your-email@gmail.com>"

# Option B: Resend API (Get a free API key at https://resend.com)
RESEND_API_KEY=""
RESEND_FROM="National Schemes Portal <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# 2. REAL LIVE SMS DISPATCH (Mobile Phones Worldwide & India)
# ------------------------------------------------------------------------------
# Option A: Twilio SMS (Global SMS delivery - https://www.twilio.com)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Option B: Fast2SMS (Indian Instant OTP SMS - https://www.fast2sms.com)
FAST2SMS_API_KEY=""

# ------------------------------------------------------------------------------
# 3. AI / RAG INTELLIGENCE (Gemini / Groq Llama)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""
GROQ_API_KEY=""
LLAMA_MODEL="llama-3.3-70b-versatile"
